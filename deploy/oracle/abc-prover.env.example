# Copy to /etc/axiom/abc-prover.env and chmod 600.
# NEVER commit this file. Keys stay here and are passed only to the process.

ABC_PROVER_WORKERS=3
AXIOM_MATHLIB=/home/ubuntu/mathlib4

# Shared daily budget. QuotaStore enforces this across all workers.
LLM_MAX_REQUESTS_PER_RUN=1
LLM_MAX_REQUESTS_PER_DAY=30
LLM_TOTAL_TIMEOUT=180
LLM_TIMEOUT=60
LLM_RETRIES=1

# One line is required: systemd EnvironmentFile cannot span lines.
# Use api_key_env so no key appears in JSON or in result files.
LLM_PROVIDERS=[{"name":"groq","base_url":"https://api.groq.com/openai/v1","api_key_env":"GROQ_API_KEY","model":"openai/gpt-oss-120b","max_requests_per_day":30,"max_retries":1},{"name":"openrouter","base_url":"https://openrouter.ai/api/v1","api_key_env":"OPENROUTER_API_KEY","model":"meta-llama/llama-3.3-70b-instruct:free","max_requests_per_day":50,"max_retries":1}]

# Replace with keys from your own free accounts.
GROQ_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME

# Optional: public GitHub raw URL used by the Render status beacon.
AXIOM_STATUS_URL=https://raw.githubusercontent.com/kortana78/axiom/main/results/abc_prover/supervisor.json
